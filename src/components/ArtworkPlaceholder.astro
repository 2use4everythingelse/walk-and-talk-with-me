---
interface Props { label: string; note?: string; compact?: boolean; }
const { label, note = 'Approved artwork will be added here.', compact = false } = Astro.props;
---
<div class:list={['artwork', { compact }]}>
  <span class="artwork-tag">Existing artwork · placeholder</span>
  <strong>{label}</strong>
  <p>{note}</p>
</div>

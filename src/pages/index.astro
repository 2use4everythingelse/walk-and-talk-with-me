---
import BaseLayout from '../layouts/BaseLayout.astro';
import Artwork from '../components/ArtworkPlaceholder.astro';
const essentials = [ ['Water', 'Bring something to sip along the way.'], ['Comfy shoes', 'Whatever feels good for a gentle walk.'], ['Bug spray', 'A little Florida preparation.'], ['Hat or visor', 'A little shade to take with you.'], ['Light snack', 'Something small, if you’d like.'], ['Headphones (optional)', 'Quiet company counts, too.'], ['Check the weather', 'Florida weather has a mind of its own. Check the radar and dress accordingly.'], ['Good vibes', 'Come as you are!'] ];
---
<BaseLayout>
  <section id="welcome" class="hero section-shell" aria-labelledby="welcome-title">
    <div class="hero-copy"><p class="eyebrow">A little movement. A little company.</p><h1 id="welcome-title">Your story has<br />a place here.</h1><p class="intro">Moving together with good people. Growing together with great conversation.</p><p>Come for a few more steps, some quiet company, or a conversation you didn’t know you needed.</p><a class="button" href="#game-plan">Let’s take a walk <span aria-hidden="true">↗</span></a><p class="walk-details">Sundays · 6:30 PM<br /><span>Reed Canal Park · South Daytona</span></p></div>
    <Artwork label="Welcome / pavilion hero" note="Approved storybook pavilion artwork with both founders, their shoes, speech bubbles, and the arrow to the path." />
  </section>
  <section id="all-welcome" class="section-shell welcome-band" aria-labelledby="all-title">
    <p class="eyebrow">01 / A place for you</p><h2 id="all-title">Company. Conversation. Contentment.</h2>
    <div class="welcome-options"><div><h3>Come alone</h3><p>Me, Myself, and I. That’s enough.</p></div><div><h3>Bring a friend</h3><p>Water. Sneakers. Best friend.</p></div><div><h3>Bring headphones</h3><p>Yes, headphones are welcome here, too.</p></div></div>
    <Artwork label="All Are Welcome — approved three-panel artwork" compact />
    <p class="emphasis">No pressure. No registration. No membership fees.</p>
  </section>
  <section id="our-story" class="section-shell split" aria-labelledby="story-title">
    <div><p class="eyebrow">02 / Long story short</p><h2 id="story-title">Sometimes, you just need a reason to get out.</h2><p>A few more steps. A little fresh air. Someone to walk beside.</p><p>Tomorrow, maybe it’s a new experience with some new friends.</p><p class="handwritten">Because why not?!</p></div><Artwork label="Long Story Short — approved legal-pad artwork" note="Final legal-pad-on-wood artwork. This space preserves the existing piece rather than recreating it." />
  </section>
  <section id="game-plan" class="olive-section" aria-labelledby="plan-title"><div class="section-shell split">
    <div><p class="eyebrow">03 / The game plan</p><h2 id="plan-title">A simple plan.<br />Room to be human.</h2><p>Because not everything goes according to plan.</p><ol class="timeline"><li><strong>6:25–6:40 PM</strong><span>Arrive, settle in, and say hello.</span></li><li><strong>6:40–6:55 PM</strong><span>A little time to connect and get going.</span></li><li><strong>6:55–7:25 PM</strong><span>Walk, talk, or enjoy some quiet company.</span></li></ol><p class="small">Times are flexible. One gentle loop usually takes about 30–45 minutes.</p></div><Artwork label="The Game Plan — approved coach’s clipboard" note="Final worn wooden clipboard artwork, with the approved flexible schedule and no map." />
  </div></section>
  <section id="bring" class="section-shell" aria-labelledby="bring-title"><div class="section-heading"><div><p class="eyebrow">04 / What to bring (suggested)</p><h2 id="bring-title">A few little things.<br />And yourself.</h2></div><p>These are suggestions. There’s no checklist to pass before you join us.</p></div><div class="essentials">{essentials.map(([title, description]) => <div><h3>{title}</h3><p>{description}</p></div>)}</div><Artwork label="What to Bring — approved corkboard artwork" note="Final eight-note corkboard with the “Come as you are!” Post-it." compact /></section>
  <section id="where" class="section-shell split location-section" aria-labelledby="where-title"><Artwork label="Where we meet — existing Reed Canal Park map artwork" note="Use the real park map in the approved design. No invented map or location illustration." /><div><p class="eyebrow">05 / Find your way here</p><h2 id="where-title">See you at<br />the pavilion.</h2><p><strong>Reed Canal Park · South Daytona</strong></p><p>Meet at the pavilion near the main entrance off Reed Canal Road, past the playground. Look for the roof, picnic tables, and bathrooms.</p><p><strong>Sundays at 6:30 PM.</strong> We’ll start with a hello and take it from there.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=Reed+Canal+Park+South+Daytona+Florida" target="_blank" rel="noopener noreferrer">Find the park on Google Maps <span class="sr-only">(opens in a new tab)</span> ↗</a></div></section>
  <section id="stories" class="section-shell stories" aria-labelledby="stories-title"><p class="eyebrow">06 / Behind the walk</p><h2 id="stories-title">A little more of the story.</h2><div class="story-grid"><article><p class="small">Blog 01 · Existing draft</p><h3>Why I Started Walk &amp; Talk with Me</h3><p>Approved blog text will be added here.</p><span class="coming-soon">Full story coming soon</span></article><article><p class="small">Blog 02 · Existing draft</p><h3>What I Hope This Becomes</h3><p>Approved blog text will be added here.</p><span class="coming-soon">Full story coming soon</span></article></div><Artwork label="Existing story / blog artwork, if supplied" note="Reserved space only. No new imagery has been created." compact /></section>
  <section id="join" class="join-section" aria-labelledby="join-title"><div class="section-shell split"><div><p class="eyebrow">07 / When you’re ready</p><h2 id="join-title">Come out.<br />We have room for you.</h2><p>Come alone, come with a friend, or come with headphones.</p><p class="emphasis">Sundays · 6:30 PM · Reed Canal Park</p><a class="button light" href="#where">Here’s where to meet us ↗</a><p class="small">No sign-up needed. Just come as you are.</p></div><Artwork label="Existing invitation artwork" note="Space for approved “When you’re ready. Come out.” artwork or an existing invitation asset." /></div></section>
</BaseLayout>
